# Simple Nostr Relay configuration.
# Every variable is optional. Application variables are validated on startup by src/config.ts.

# PORT=3000
# DATABASE_PATH=database.sqlite

# NIP-26 delegated events (unrecommended NIP; disabled unless set to exactly "true")
# ENABLE_NIP26=true

# NIP-11 relay information
# RELAY_NAME=Honostr Test Relay
# RELAY_DESCRIPTION=Honostr Test Relay
# RELAY_PUBKEY=36d931a0c3e540393015c9ba9df8718b6259bf36180c9c4ef230ecc135c59c52
# RELAY_CONTACT=inari@inaridiy.com

# Limits (also advertised via NIP-11 "limitation")
# MAX_MESSAGE_BYTES=131072
# MAX_SUBSCRIPTIONS_PER_CONNECTION=20
# MAX_FILTERS_PER_REQUEST=10
# MAX_MESSAGES_PER_MINUTE=300
# MAX_QUERY_LIMIT=2000

# Signature-verification workers (default: min(8, CPUs - 1); set 0 for direct verification)
# RAYON_NUM_THREADS=8
