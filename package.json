{
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "dotenvx run -- tsx src/index.ts",
    "format": "biome format . --write",
    "lint": "biome check .",
    "lint:fix": "pnpm lint --apply",
    "lint:repo": "sherif",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "migrate": "pnpm drizzle-kit generate && pnpm tsx scripts/migrate.ts",
    "typia:generate": "pnpm typia generate --input src/validators --output src/generated/typia --project tsconfig.json",
    "preinstall": "npx only-allow pnpm",
    "prepare": "ts-patch install && typia patch && pnpm simple-git-hooks"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.13",
    "@hono/node-ws": "1.3.1",
    "@noble/curves": "^1.4.2",
    "@noble/hashes": "^1.4.0",
    "better-sqlite3": "^12.11.1",
    "bufferutil": "^4.0.8",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "tiny-secp256k1": "^2.2.4",
    "typia": "^6.5.0",
    "uuidv7": "^1.0.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.7.3",
    "@dotenvx/dotenvx": "^1.14.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.17",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "nostr-tools": "^2.7.2",
    "sherif": "^0.8.4",
    "simple-git-hooks": "^2.11.1",
    "ts-patch": "^3.2.1",
    "tsx": "^4.11.0",
    "typescript": "~5.6.3",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm format && pnpm lint:fix"
  }
}
