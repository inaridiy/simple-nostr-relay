{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "vite build",
    "dev": "pnpm build && pnpm start",
    "dev:watch": "RAYON_SEQUENTIAL=1 tsx watch src/index.ts",
    "start": "dotenvx run --ignore=MISSING_ENV_FILE -- node dist/index.js",
    "bench:rayon": "pnpm build && tsx scripts/benchmark-rayon.ts",
    "format": "biome format . --write",
    "lint": "biome check .",
    "lint:fix": "pnpm lint --apply",
    "lint:repo": "sherif --ignore-rule root-package-dependencies",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "migrate": "pnpm drizzle-kit generate && pnpm tsx scripts/migrate.ts",
    "typia:generate": "pnpm typia generate --input src/validators --output src/generated/typia --project tsconfig.json",
    "preinstall": "npx only-allow pnpm",
    "prepare": "ts-patch install && typia patch && pnpm simple-git-hooks"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@noble/curves": "^1.4.2",
    "@noble/hashes": "^1.4.0",
    "@samchon/openapi": "^2.5.3",
    "better-sqlite3": "^12.11.1",
    "bufferutil": "^4.0.8",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "rayon-ts": "^0.1.1",
    "tiny-secp256k1": "^2.2.4",
    "typia": "^7.6.4",
    "uuidv7": "^1.0.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.7.3",
    "@dotenvx/dotenvx": "^1.14.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.17",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "nostr-tools": "^2.7.2",
    "sherif": "^0.8.4",
    "simple-git-hooks": "^2.11.1",
    "ts-patch": "^3.2.1",
    "tsx": "^4.11.0",
    "typescript": "~5.7.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm format && pnpm lint:fix"
  }
}
